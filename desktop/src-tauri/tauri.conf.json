{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penpot",
  "version": "0.1.0",
  "identifier": "app.penpot.desktop",
  "build": {
    "beforeDevCommand": "npm run build:stub",
    "beforeBuildCommand": "npm run build:stub",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
